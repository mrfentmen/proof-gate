# Copy this file to .env and fill in your own values. Never commit .env.

# --- PayPal sandbox (required for a live payment release) ---
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# Make sure the app has the "Invoicing" feature enabled.
# Without these, the gate still runs end to end — audits, decisions, ledger —
# but an approved case stops at "approved — release pending credentials"
# and the release endpoint answers 503. Nothing is ever faked as paid.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. Proof Gate is built and judged in sandbox mode.
PAYPAL_ENV=sandbox

# --- Server ---
PORT=3000
# Where cases are persisted (JSON file store). Defaults to ./data.
# DATA_DIR=/some/other/path
